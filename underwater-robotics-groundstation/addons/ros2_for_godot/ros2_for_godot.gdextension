[configuration]

entry_symbol = "ros2_for_godot_init"
compatibility_minimum = "4.2"

[libraries]

linux.debug.arm64 = "res://addons/ros2_for_godot/bin/linux.arm64/libros2_for_godot.so"
linux.release.arm64 = "res://addons/ros2_for_godot/bin/linux.arm64/libros2_for_godot.so"
linux.debug.x86_64 = "res://addons/ros2_for_godot/bin/linux.x86_64/libros2_for_godot.so"
linux.release.x86_64 = "res://addons/ros2_for_godot/bin/linux.x86_64/libros2_for_godot.so"
